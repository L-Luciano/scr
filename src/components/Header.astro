---
import { CHEMIN_LOGO, TOKENS_CHARTE } from '../domain/brand-system/charte-graphique'
import { NOM_CLUB } from '../domain/club-presentation/identite-club.schema'
const fond = TOKENS_CHARTE['noir-anthracite']
const accent = TOKENS_CHARTE.rose
const texte = TOKENS_CHARTE.blanc

// Navigation : une seule liste de liens, rendue en ligne (bureau) et dans le menu dépliant (mobile).
interface Lien { href: string; libelle: string; sous?: Lien[] }
const LIENS: Lien[] = [
  { href: '/', libelle: 'Accueil' },
  {
    href: '/le-club',
    libelle: 'Le club',
    sous: [
      { href: '/le-club', libelle: 'Présentation' },
      { href: '/le-club/projet', libelle: 'Le projet' },
      { href: '/le-club/valeurs', libelle: 'Les valeurs' },
      { href: '/le-club/bureau', libelle: 'Le bureau' },
    ],
  },
  { href: '/categories', libelle: 'Catégories' },
  { href: '/actualites', libelle: 'Actualités' },
  { href: '/partenaires', libelle: 'Partenaires' },
]
const CTA = { href: '/rejoindre', libelle: 'Rejoindre / Contact' }

// Page courante : l'Accueil ne s'active que sur « / », les autres rubriques aussi sur leurs sous-pages (ex. détail d'une actualité).
const chemin = Astro.url.pathname.replace(/\/+$/, '') || '/'
const estCourante = (href: string) => (href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(href + '/'))
const courant = (href: string) => (estCourante(href) ? 'page' : undefined)
// Sous-lien : courant uniquement sur correspondance exacte, et jamais en doublon du parent qui porte déjà la marque.
const courantExact = (href: string, parent: string) => (chemin === href && href !== parent ? 'page' : undefined)

// Feuille globale : les seules couleurs viennent de TOKENS_CHARTE, injectées en variables CSS sur :root.
const styleGlobal = `:root { --fond: ${fond}; --accent: ${accent}; --texte: ${texte}; }` + `

  /* Charte : les seules couleurs proviennent de TOKENS_CHARTE (charte-graphique.ts). */
  * { box-sizing: border-box; }
  html { background: var(--fond); color: var(--texte); font-family: 'Helvetica Neue', Arial, sans-serif; line-height: 1.5; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; width: 100%; max-width: 64rem; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
  h1, h2, h3 { text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.15; }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 1rem; }
  h1 em, .accent { color: var(--accent); font-style: normal; }
  /* Intertitres en rose de la charte, avec un court liseré : hiérarchie visible dans les pages de contenu. */
  main h2 { color: var(--accent); font-size: clamp(1.35rem, 3vw, 1.75rem); margin: 2.5rem 0 0.75rem; padding-top: 0.75rem; position: relative; }
  main h2::before { content: ""; display: block; width: 3rem; height: 3px; background: var(--accent); margin-bottom: 0.75rem; }
  main h3 { color: var(--accent); font-size: 1.1rem; margin: 1.75rem 0 0.5rem; }
  .carte h2, .membre h2 { color: var(--texte); font-size: 1.35rem; margin: 0.5rem 0; padding-top: 0; }
  .carte h2::before, .membre h2::before { display: none; }
  .carte h2 a { color: var(--texte); text-decoration: none; }
  main strong { color: var(--accent); }
  a { color: var(--accent); }
  img { max-width: 100%; height: auto; display: block; }
  .visuel { border: 2px solid var(--accent); border-radius: 0.5rem; margin: 1.5rem 0; }
  .liseret { width: 12rem; height: 0.5rem; background: var(--accent); margin: 1rem 0 2rem; }
  .piliers { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); padding: 0; margin: 0; list-style: none; counter-reset: pilier; }
  .piliers li { border: 1px solid var(--accent); border-radius: 0.5rem; padding: 1.25rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .piliers li::before { counter-increment: pilier; content: counter(pilier, decimal-leading-zero); display: block; color: var(--accent); font-size: 0.85rem; margin-bottom: 0.5rem; }
  .bouton { display: inline-block; background: var(--accent); color: var(--fond); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none; padding: 0.9rem 1.5rem; border-radius: 999px; }
  .cartes { display: grid; gap: 1.5rem; padding: 0; margin: 0; list-style: none; }
  .carte { border: 1px solid var(--accent); border-radius: 0.5rem; overflow: hidden; }
  .carte-corps { padding: 1.25rem; }
  .carte time { color: var(--accent); font-size: 0.9rem; letter-spacing: 0.08em; }
  /* En-tête : bureau = logo à gauche, navigation centrée ; mobile = logo + icône trois barres, menu dépliant. */
  .entete { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--accent); position: relative; }
  .entete .marque { display: flex; align-items: center; gap: 0.75rem; color: var(--texte); text-decoration: none; min-width: 0; }
  .entete .marque img { border-radius: 50%; width: 56px; height: 56px; flex: none; }
  .entete .nom { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem; line-height: 1.2; }
  .entete .nom strong { color: var(--accent); }
  .entete nav a { color: var(--texte); text-decoration: none; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.1em; }
  .entete a.cta { color: var(--fond); background: var(--accent); padding: 0.55rem 1rem; border-radius: 999px; font-weight: 700; text-decoration: none; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.1em; white-space: nowrap; }
  .cta-bureau { display: none; }
  .entete nav a[aria-current="page"]:not(.cta) { color: var(--accent); font-weight: 700; }
  .nav-bureau > a, .groupe > a { position: relative; padding: 0.35rem 0; }
  .nav-bureau > a::after, .groupe > a .libelle::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; border-radius: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.2s ease; }
  .groupe > a { padding: 0; }
  .groupe > a .libelle { position: relative; display: inline-block; padding: 0.35rem 0; }
  .nav-bureau > a:hover::after, .nav-bureau > a[aria-current="page"]::after, .groupe:hover > a .libelle::after, .groupe:focus-within > a .libelle::after, .groupe > a[aria-current="page"] .libelle::after { transform: scaleX(1); }
  .entete a.cta[aria-current="page"] { box-shadow: 0 0 0 3px var(--fond), 0 0 0 5px var(--accent); }
  .menu nav a[aria-current="page"]:not(.cta) { border-left: 4px solid var(--accent); box-shadow: none; }
  .nav-bureau { display: none; }
  .menu { grid-column: 3; position: relative; }
  .menu summary { list-style: none; cursor: pointer; display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; color: var(--texte); border: 1px solid var(--accent); border-radius: 999px; user-select: none; }
  .menu summary::-webkit-details-marker, .menu summary::marker { display: none; content: ""; }
  .menu .barres { width: 1.25rem; height: 2px; background: currentColor; position: relative; display: block; }
  .menu .barres::before, .menu .barres::after { content: ""; position: absolute; left: 0; width: 100%; height: 2px; background: currentColor; }
  .menu .barres::before { top: -7px; }
  .menu .barres::after { top: 7px; }
  .menu[open] summary { background: var(--accent); color: var(--fond); }
  .menu nav { position: absolute; right: 0; top: calc(100% + 0.75rem); min-width: 16rem; background: var(--fond); border: 1px solid var(--accent); border-radius: 0.75rem; padding: 0.75rem; display: grid; gap: 0.25rem; z-index: 10; }
  .menu nav a { display: block; padding: 0.85rem 1rem; border-radius: 0.5rem; }
  .menu nav a.cta { text-align: center; margin-top: 0.5rem; }
  .groupe { position: relative; }
  .groupe > a { display: inline-flex; align-items: center; gap: 0.45rem; }
  .groupe > a .chevron { display: inline-block; width: 0.38em; height: 0.38em; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-0.12em) rotate(45deg); opacity: 0.7; transition: transform 0.2s ease, opacity 0.2s ease; }
  .groupe:hover > a .chevron, .groupe:focus-within > a .chevron { transform: translateY(0.1em) rotate(225deg); opacity: 1; }
  .sous-menu { position: absolute; left: 50%; transform: translateX(-50%); top: calc(100% + 0.6rem); min-width: 12rem; margin: 0; padding: 0.5rem; list-style: none; background: var(--fond); border: 1px solid var(--accent); border-radius: 0.75rem; display: none; z-index: 10; }
  .sous-menu li a { display: block; padding: 0.6rem 0.9rem; border-radius: 0.5rem; }
  .sous-menu li a[aria-current="page"] { color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
  .groupe:hover .sous-menu, .groupe:focus-within .sous-menu { display: block; }
  .groupe::after { content: ""; position: absolute; left: 0; right: 0; height: 0.8rem; top: 100%; }
  .menu nav a.sous { padding-left: 2.25rem; font-size: 0.8rem; opacity: 0.9; }
  .valeurs { display: grid; gap: 1.25rem; padding: 0; margin: 1.5rem 0 0; list-style: none; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  .valeur { border: 1px solid var(--accent); border-radius: 0.75rem; padding: 1.25rem 1.5rem; display: grid; gap: 0.6rem; align-content: start; }
  .valeur:not(.revelee) { border-style: dashed; opacity: 0.75; }
  .valeur .numero { color: var(--accent); font-weight: 800; letter-spacing: 0.12em; font-size: 0.85rem; }
  .valeur h2 { margin: 0; padding-top: 0; font-size: 1.3rem; }
  .valeur h2::before { display: none; }
  .valeur blockquote { margin: 0; padding-left: 0.9rem; border-left: 3px solid var(--accent); font-style: italic; }
  .valeur blockquote p { margin: 0; }
  .format { margin-top: 1.5rem; }
  .categories { display: grid; gap: 0.75rem; padding: 0; margin: 0.75rem 0 0; list-style: none; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .categorie { border: 1px solid var(--accent); border-radius: 0.5rem; padding: 0.9rem 1rem; display: grid; gap: 0.2rem; }
  .categorie .nom { color: var(--accent); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; }
  .categorie .precision { font-size: 0.85rem; opacity: 0.85; }
  .categorie .educateurs { font-size: 0.95rem; }
  .piliers-detail li { text-transform: none; letter-spacing: 0; }
  .piliers-detail li::first-line { text-transform: uppercase; letter-spacing: 0.06em; }
  @media (min-width: 1024px) {
    .entete { padding: 1rem 1.25rem; grid-template-columns: 1fr auto 1fr; }
    .entete .marque img { width: 72px; height: 72px; }
    .nav-bureau { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.25rem; align-items: center; grid-column: 2; }
    .cta-bureau { display: inline-block; grid-column: 3; justify-self: end; }
    .menu { display: none; }
  }
  .pied { border-top: 1px solid var(--accent); padding: 1.5rem 1.25rem; font-size: 0.9rem; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
  .pied nav a { color: var(--texte); }
  .pied a { color: var(--texte); }
  dl.fiche { display: grid; grid-template-columns: 1fr; gap: 0.25rem 1.5rem; }
  dl.fiche dt { color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; }
  dl.fiche dd { margin: 0 0 0.75rem; overflow-wrap: anywhere; }
  @media (min-width: 768px) { dl.fiche { grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem; } dl.fiche dd { margin: 0; } }
  .partenaires { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; list-style: none; }
  .partenaires li { border: 1px solid var(--accent); border-radius: 999px; padding: 0.4rem 1rem; }
  .accroche { font-size: 1.35rem; font-weight: 700; line-height: 1.3; }
  .pilier-accroche { display: block; margin-top: 0.6rem; font-weight: 400; text-transform: none; letter-spacing: 0; opacity: 0.9; }
  .mentalite { border-left: 4px solid var(--accent); padding-left: 1rem; margin: 2rem 0; font-size: 1.05rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin: 2rem 0; }
  .lien-secondaire { color: var(--texte); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.85rem; }
  .etapes { padding-left: 1.25rem; display: grid; gap: 0.75rem; }
  .programme-sportif { border: 2px solid var(--accent); border-radius: 0.5rem; padding: 1.25rem 1.5rem; margin: 1rem 0 2rem; display: grid; gap: 0.35rem; }
  .programme-sportif .statut { color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8rem; font-weight: 700; }
  .programme-sportif .nom { font-size: 1.4rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; }
  .membres { display: grid; gap: 2rem; padding: 0; margin: 0; list-style: none; }
  .membre { border: 1px solid var(--accent); border-radius: 0.5rem; padding: 1.5rem; display: grid; gap: 0.75rem; }
  .membre .initiales { width: 4rem; height: 4rem; border-radius: 50%; background: var(--accent); color: var(--fond); display: grid; place-items: center; font-weight: 800; font-size: 1.4rem; letter-spacing: 0.05em; }
  .membre .role { color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.8rem; font-weight: 700; }
  .membre h2 { margin: 0; font-size: 1.5rem; }
  .membre blockquote { margin: 0.5rem 0 0; padding-left: 1rem; border-left: 4px solid var(--accent); font-size: 1.1rem; font-style: italic; }
  .membre blockquote footer { font-style: normal; font-size: 0.85rem; opacity: 0.8; margin-top: 0.4rem; }
`
---
<header class="entete">
  <a class="marque" href="/">
    <img src={CHEMIN_LOGO} alt={`Logo du ${NOM_CLUB}`} width="72" height="72" />
    <span class="nom">Sporting Club <strong>Roquettan</strong></span>
  </a>
  <nav class="nav-bureau" aria-label="Navigation principale">
    {LIENS.map(lien =>
      lien.sous ? (
        <div class="groupe">
          <a href={lien.href} aria-current={courant(lien.href)} aria-haspopup="true"><span class="libelle">{lien.libelle}</span><span class="chevron" aria-hidden="true"></span></a>
          <ul class="sous-menu">
            {lien.sous.map(sous => <li><a href={sous.href} aria-current={courantExact(sous.href, lien.href)}>{sous.libelle}</a></li>)}
          </ul>
        </div>
      ) : (
        <a href={lien.href} aria-current={courant(lien.href)}>{lien.libelle}</a>
      ),
    )}
  </nav>
  <a class="cta cta-bureau" href={CTA.href} aria-current={courant(CTA.href)}>{CTA.libelle}</a>
  <details class="menu">
    <summary aria-label="Ouvrir le menu" title="Menu"><span class="barres" aria-hidden="true"></span></summary>
    <nav aria-label="Navigation principale (mobile)">
      {LIENS.map(lien => (
        <>
          <a href={lien.href} aria-current={courant(lien.href)}>{lien.libelle}</a>
          {lien.sous?.filter(sous => sous.href !== lien.href).map(sous => (
            <a class="sous" href={sous.href} aria-current={courantExact(sous.href, lien.href)}>{sous.libelle}</a>
          ))}
        </>
      ))}
      <a class="cta" href={CTA.href} aria-current={courant(CTA.href)}>{CTA.libelle}</a>
    </nav>
  </details>
</header>

<style is:global set:html={styleGlobal}></style>
