---
import { getCollection, render } from 'astro:content'
import Seo from '../components/Seo.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getEquipe } from '../application/get-equipe.query'

const entrees = await getCollection('membres')
const equipe = getEquipe(entrees.map(e => e.data))
const rendus = await Promise.all(
  equipe.membres.map(async membre => {
    const entree = entrees.find(e => e.data.nom === membre.nom)!
    const { Content } = await render(entree)
    return { membre, Content }
  }),
)
const initiales = (nom: string) => nom.split(/\s+/).map(m => m[0]).join('').slice(0, 3).toUpperCase()
---
<html lang="fr">
  <head><Seo meta={equipe.meta} /></head>
  <body>
    <Header />
    <main>
      <h1>L'<em>équipe</em></h1>
      <div class="liseret"></div>
      <p>Un club neuf se reconnaît à celles et ceux qui le portent. Voici les dirigeants et l'encadrement du Sporting Club Roquettan, et le message que les dirigeants adressent aux familles.</p>
      <ul class="membres">
        {rendus.map(({ membre, Content }) => (
          <li class="membre">
            <span class="initiales" aria-hidden="true">{initiales(membre.nom)}</span>
            <span class="role">{membre.role}</span>
            <h2>{membre.nom}</h2>
            {membre.message && (
              <blockquote>
                <p>« {membre.message} »</p>
                <footer>{membre.nom}, {membre.role.toLowerCase()} du Sporting Club Roquettan</footer>
              </blockquote>
            )}
            <Content />
          </li>
        ))}
      </ul>
      <h2>Les éducateurs</h2>
      <p>Le staff technique de la saison 2026-2027 : Nicolas Longo (baby-foot, U11), Benjamin Guibal (U6 / U7), Franck Moreau (U8, U12), Ahmed Benaied (U9), Valentin Silvent (U10), Amine Badji (U11), Bérangère Inghels (U12), Philippe Ravetta (U17) et Ralid Mechitoua (seniors). Le détail par catégorie est sur la page <a href="/categories/">Catégories</a>.</p>
    </main>
    <Footer />
  </body>
</html>
