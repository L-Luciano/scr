---
import { getEntry, render } from 'astro:content'
import Seo from '../components/Seo.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getLeClub } from '../application/get-le-club.query'
import { lienCarte } from '../domain/club-presentation/identite-club.schema'

const identite = await getEntry('identiteClub', 'identite-club')
if (!identite) throw new Error('Contenu identite-club.md introuvable.')
const leClub = getLeClub(identite.data)
const { Content } = await render(identite)
---
<html lang="fr">
  <head><Seo meta={leClub.meta} /></head>
  <body>
    <Header />
    <main>
      <p class="accent">Le club · Présentation</p>
      <h1>Le <em>club</em></h1>
      <div class="liseret"></div>
      <Content />
      <h2>Où nous trouver</h2>
      <p>{leClub.lieuClub.nom}, {leClub.lieuClub.adresse} · <a href={lienCarte(leClub.lieuClub)} rel="noopener">Voir sur la carte</a></p>
    </main>
    <Footer />
  </body>
</html>
