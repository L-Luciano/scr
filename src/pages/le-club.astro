---
import { getEntry, render } from 'astro:content'
import Seo from '../components/Seo.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PartenaireBadge from '../components/PartenaireBadge.astro'
import { getLeClub } from '../application/get-le-club.query'

const identite = await getEntry('identiteClub', 'identite-club')
if (!identite) throw new Error('Contenu identite-club.md introuvable.')
const leClub = getLeClub(identite.data)
const { Content } = await render(identite)
---
<html lang="fr">
  <head><Seo meta={leClub.meta} /></head>
  <body>
    <Header />
    <main>
      <h1>Le <em>club</em></h1>
      <div class="liseret"></div>
      <ol class="piliers">
        {leClub.projetClub.piliers.map(pilier => <li>{pilier}</li>)}
      </ol>
      <h2>Où nous trouver</h2>
      <p>{leClub.lieuClub.nom}, {leClub.lieuClub.adresse}</p>
      <h2>Programme sportif</h2>
      {leClub.programmeSportif && (
        <div class="programme-sportif">
          <span class="statut">{leClub.programmeSportif.statut} · {leClub.programmeSportif.organisme}</span>
          <span class="nom">{leClub.programmeSportif.nom}</span>
          <p>Pour la saison 2026-2027, le SCR est club satellite au sein du programme Ünseme de l'AS Monaco. Ce lien est purement sportif ; ses modalités détaillées : à compléter par le club.</p>
        </div>
      )}
      <h2>Partenaires</h2>
      <ul class="partenaires">
        {leClub.partenaires.map(partenaire => <PartenaireBadge partenaire={partenaire} />)}
      </ul>
      <Content />
    </main>
    <Footer />
  </body>
</html>
