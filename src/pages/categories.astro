---
import { getEntry, render } from 'astro:content'
import Seo from '../components/Seo.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getCategories } from '../application/get-categories.query'

const entree = await getEntry('categories', 'categories')
if (!entree) throw new Error('Contenu categories.md introuvable.')
const categories = getCategories(entree.data)
const { Content } = await render(entree)
---
<html lang="fr">
  <head><Seo meta={categories.meta} /></head>
  <body>
    <Header />
    <main>
      <h1>Caté<em>gories</em></h1>
      <div class="liseret"></div>
      <p class="accroche">{categories.introduction}</p>
      {categories.groupes.map(groupe => (
        <section class="format">
          <h2>{groupe.format}</h2>
          <ul class="categories">
            {groupe.categories.map(categorie => (
              <li class="categorie">
                <span class="nom">{categorie.nom}</span>
                {categorie.precision && <span class="precision">{categorie.precision}</span>}
                <span class="educateurs">{categorie.educateurs.join(' · ')}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <Content />
      <p class="actions"><a class="bouton" href="/rejoindre">Nous contacter</a> <a class="lien-secondaire" href="/equipe">Découvrir l'équipe</a></p>
    </main>
    <Footer />
  </body>
</html>
